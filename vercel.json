{
  "functions": {
    "api/cards.js": {
      "maxDuration": 300
    },
    "api/explain.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/b/:id",
      "destination": "/birthday/surprise.html"
    },
    {
      "source": "/r/:id",
      "destination": "/recharge/gift.html"
    },
    {
      "source": "/c/:id",
      "destination": "/recharge/magazine.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/birthday",
      "permanent": false
    }
  ]
}