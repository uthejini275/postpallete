# Copy this file to .env for local testing. On Vercel, add these under Settings → Environment Variables.

# Required: your Claude API key from https://platform.claude.com (keep it secret, never post it anywhere)
ANTHROPIC_API_KEY=

# Optional: test the site without an API key or any cost (shows a fake test deck)
# MOCK_AI=1

# Optional: which Claude model makes the cards (default claude-sonnet-5-5, good quality).
# claude-opus-5-5 = best quality, costs more. claude-haiku-5-5 = basic quality, far cheaper.
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_EFFORT=low

# Optional: free limits
# FREE_DECKS_PER_DAY=3
# FREE_EXPLAINS_PER_DAY=30
# SITE_DECKS_PER_DAY=50

# Optional but recommended: Upstash Redis (free) so limits work reliably. Added automatically
# if you connect Upstash from Vercel's Storage tab.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---------- Birthday surprise shop ----------
# Your owner password for /admin.html (make it long, at least 8 characters, keep it secret)
ADMIN_KEY=
# Your UPI ID for payments, e.g. name@okhdfcbank (shown to customers with a QR code)
UPI_ID=
# Name shown in the customer's UPI app
# UPI_NAME=Post Pallete Studio
# Price in rupees
# BIRTHDAY_PRICE=29
# Price in rupees for a Recharge Him (Men's Day) gift at /recharge
# RECHARGE_PRICE=50
# Your Instagram username (without @)
# INSTAGRAM_HANDLE=postpallete_.stdio
# New surprise pages one person can create per day
# FREE_SURPRISES_PER_DAY=10
# Automatic payments (from razorpay.com → API Keys). Keep the secret private.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
